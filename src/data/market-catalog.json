    {
      "key": "baota-mcp-server",
      "name": "baota-mcp-server",
      "displayName": "宝塔面板 MCP Server",
      "description": "宝塔面板运维能力（远程 HTTP MCP）。需在面板安装「宝塔 MCP 服务」插件并放行 8765、配置 IP 白名单；地址形如 https://<面板IP>:8765/bt-mcp-<实例>/mcp，令牌走 Authorization 头。",
      "repository": "https://docs.bt.cn/ai-ops/mcp/installation",
      "categories": [
        "baota"
      ],
      "tags": [
        "baota",
        "bt",
        "panel",
        "host"
      ],
      "runtime": "npm",
      "slotLabels": {
        "BT_MCP_URL": "MCP 地址（https://<IP>:8765/bt-mcp-<实例>/mcp）",
        "BT_MCP_TOKEN": "授权令牌"
      },
      "installations": {
        "npm": {
          "url": "${BT_MCP_URL}",
          "headers": {
            "Authorization": "Bearer ${BT_MCP_TOKEN}"
          }
        }
      }
    },
