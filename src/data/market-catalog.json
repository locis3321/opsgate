    {
      "key": "mysql-mcp-server",
      "name": "mysql-mcp-server",
      "displayName": "MySQL MCP Server",
      "description": "MySQL 执行 SQL / 查表结构 / 取样行（实测 3 个工具）",
      "repository": "https://pypi.org/project/mysql-mcp-server/",
      "categories": [
        "mysql"
      ],
      "tags": [
        "database",
        "sql"
      ],
      "runtime": "pypi",
      "slotLabels": {
        "MYSQL_HOST": "主机地址",
        "MYSQL_USER": "用户名",
        "MYSQL_PASSWORD": "密码"
      },
      "installations": {
        "pypi": {
          "command": "uvx",
          "args": [
            "--from",
            "mysql-mcp-server==0.4.5",
            "mysql_mcp_server"
          ],
          "env": {
            "MYSQL_HOST": "${host}",
            "MYSQL_PORT": "3306",
            "MYSQL_USER": "${username}",
            "MYSQL_PASSWORD": "${password}"
          }
        }
      }
