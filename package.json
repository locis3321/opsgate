{
  "name": "opsgate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/db/seed.ts",
    "check:redlines": "node scripts/check-redlines.mjs",
    "postbuild": "node scripts/copy-dist-assets.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "drizzle-kit": "~0.31.11",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "~4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-auth": "^1.7.11",
    "better-sqlite3": "~12.11.1",
    "drizzle-orm": "~0.44.7",
    "fastify": "^5.12.7",
    "ioredis": "6.1.0",
    "ipaddr.js": "^2.5.0",
    "kafkajs": "2.2.4",
    "safe-regex2": "^5.1.2",
    "ssh2": "^1.17.0",
    "tree-kill": "^1.2.2",
    "zod": "^4.6.7"
  }
}
